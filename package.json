{
  "name": "mithaq-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mithaq General Supplies: bilingual (Arabic/English) corporate catalogue website for al-mithaq.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/og/check.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:client": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "og": "node scripts/og-images.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
